{
  "hybrid": [
    {
      "name": "H1_default_success",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello",
      "ocr_text": "World",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello\n[OCR]\nWorld",
      "expected_ocr_calls": 1
    },
    {
      "name": "H2_return_html_on_ocr_io",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Data",
      "ocr_text": "",
      "expected_status": "return",
      "expected_text": "[HTML]\nData",
      "expected_ocr_calls": 1
    },
    {
      "name": "H3_html_io_skips_ocr",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "",
      "ocr_text": "Ignored",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": -1
    }
  ],
  "html": [
    {
      "name": "T1_ignores_script_style_noscript",
      "markup": "<body><p>Visible</p><script>hide()</script><style>.x{}</style><noscript>off</noscript></body>",
      "expected_text": "Visible"
    },
    {
      "name": "T2_ignores_template",
      "markup": "<body><template><p>Hidden</p></template><p>Shown</p></body>",
      "expected_text": "Shown"
    },
    {
      "name": "T3_ignores_hidden_attr",
      "markup": "<body><p hidden>Hidden</p><p>Visible</p></body>",
      "expected_text": "Visible"
    }
  ]
