      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": -1
    }
  ],
  "html": [
    {
      "name": "html_strip_script_style",
      "markup": "<body><script>var x=1;</script><style>.c{}</style><p>Visible</p></body>",
      "expected_text": "Visible"
    },
    {
      "name": "html_ignore_template",
      "markup": "<body><template><p>Hidden</p></template><p>Visible</p></body>",
      "expected_text": "Visible"
    },
    {
      "name": "html_ignore_hidden_attr",
      "markup": "<body><p hidden>Hidden</p><p>Visible</p></body>",
      "expected_text": "Visible"
    }
  ]
