{
  "hybrid": [
    {
      "name": "hybrid_success_standard",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello",
      "ocr_text": "World",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello\n[OCR]\nWorld",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_ocr_io_return_html",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Data",
      "ocr_text": "",
      "expected_status": "return",
      "expected_text": "[HTML]\nData",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_html_io_skip_ocr",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "",
      "ocr_text": "",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": 0
    }
  ],
  "html": [
    {
      "name": "html_ignore_scripts",
      "markup": "<body><p>Visible</p><script>var x=1;</script><style>.cls{}</style></body>",
      "expected_text": "Visible"
    },
    {
      "name": "html_ignore_templates",
      "markup": "<body><p>Real</p><template><p>Hidden</p></template></body>",
      "expected_text": "Real"
    },
    {
      "name": "html_ignore_hidden",
      "markup": "<body><p>Visible</p><div hidden>Hidden</div></body>",
      "expected_text": "Visible"
    }
  ]
}
