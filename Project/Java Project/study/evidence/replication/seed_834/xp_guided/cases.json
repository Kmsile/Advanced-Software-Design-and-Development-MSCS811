{
  "hybrid": [
    {
      "name": "H1-successful-extraction-with-default-policy",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello World",
      "ocr_text": "Scanned Page",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello World\n[OCR]\nScanned Page",
      "expected_ocr_calls": 1
    },
    {
      "name": "H2-ocr-io-failure-with-return-html-policy",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Visible Content",
      "ocr_text": "",
      "expected_status": "return",
      "expected_text": "[HTML]\nVisible Content",
      "expected_ocr_calls": 1
    },
    {
      "name": "H3-html-io-skips-ocr-with-default-policy",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "",
      "ocr_text": "Should Not Appear",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": 0
    }
  ],
  "html": [
    {
      "name": "T1-ignores-script-and-style-tags",
      "markup": "<body><p>Text</p><script>var x=1;</script><style>.c{}</style></body>",
      "expected_text": "Text"
    },
    {
      "name": "T2-ignores-template-element-contents",
      "markup": "<body><p>Visible</p><template><p>Hidden</p></template></body>",
      "expected_text": "Visible"
    },
    {
      "name": "T3-ignores-hidden-attribute-elements",
      "markup": "<body><p>Shown</p><p hidden>Hidden</p></body>",
      "expected_text": "Shown"
    }
  ]
}
