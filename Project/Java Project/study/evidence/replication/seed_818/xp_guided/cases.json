{
  "hybrid": [
    {
      "name": "H1_default_success",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello",
      "ocr_text": "World",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello\n[OCR]\nWorld",
      "expected_ocr_calls": 1
    },
    {
      "name": "H2_return_html_on_ocr_io",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Content",
      "ocr_text": "",
      "expected_status": "return",
      "expected_text": "[HTML]\nContent",
      "expected_ocr_calls": 1
    },
    {
      "name": "H3_html_io_skips_ocr",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "",
      "ocr_text": "",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": -1
    }
  ],
  "html": [
    {
      "name": "T1_ignore_script_style_noscript",
      "markup": "<body><p>Visible</p><script>var x=1;</script><style>.cls{}</style><noscript>No JS</noscript></body>",
      "expected_text": "Visible"
    },
    {
      "name": "T2_ignore_template_elements",
      "markup": "<body><p>Before</p><template><div>Hidden</div></template><p>After</p></body>",
      "expected_text": "BeforeAfter"
    },
    {
      "name": "T3_ignore_hidden_attribute",
      "markup": "<body><p>Visible</p><p hidden>Hidden</p><div hidden><span>Also Hidden</span></div></body>",
      "expected_text": "Visible"
    }
  ]
}
