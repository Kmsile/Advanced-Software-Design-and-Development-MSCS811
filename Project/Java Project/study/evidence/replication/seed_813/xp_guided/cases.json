      "expected_text": "[HTML]\nData",
      "expected_ocr_calls": 1
    },
    {
      "name": "H3_html_io_skip_ocr",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "",
      "ocr_text": "Ignored",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": -1
    }
  ],
  "html": [
    {
      "name": "T1_ignore_script_style",
