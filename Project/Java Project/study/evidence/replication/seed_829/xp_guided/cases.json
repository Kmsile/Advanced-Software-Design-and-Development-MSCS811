{
  "hybrid": [
    {
      "name": "H1_success_default",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello",
      "ocr_text": "World",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello\n[OCR]\nWorld",
      "expected_ocr_calls": 1
    },
    {
      "name": "H2_ocr_io_return_html",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Data",
      "ocr_text": "Ignored",
      "expected_status": "return",
      "expected_text": "[HTML]\nData",
      "expected_ocr_calls": 1
    },
    {
      "name": "H3_html_io_skip_ocr",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "Error",
      "ocr_text": "Skipped",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": 0
    }
  ],
  "html": [
    {
      "name": "T1_ignore_script_style_noscript",
      "markup": "<body><p>Visible</p><script>var x=1;</script><style>.c{}</style><noscript>JS Off</noscript></body>",
      "expected_text": "Visible"
    },
    {
      "name": "T2_ignore_template",
      "markup": "<body><p>Before</p><template><div>Hidden</div></template><p>After</p></body>",
      "expected_text": "Before After"
    },
    {
      "name": "T3_ignore_hidden_attribute",
      "markup": "<body><p>Show</p><p hidden>Hide</p></body>",
      "expected_text": "Show"
    }
  ]
}
