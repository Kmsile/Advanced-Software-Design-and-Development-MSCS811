{
  "hybrid": [
    {
      "name": "hybrid_success_standard",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello",
      "ocr_text": "World",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello\n[OCR]\nWorld",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_ocr_io_return_html",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Data",
      "ocr_text": "Ignored",
      "expected_status": "return",
      "expected_text": "[HTML]\nData",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_html_io_skip_ocr",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "",
      "ocr_text": "Skipped",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": 0
    }
  ],
  "html": [
    {
      "name": "html_ignore_script_style",
      "markup": "<body><script>var x=1;</script><p>Visible</p><style>body{}</style></body>",
      "expected_text": "Visible"
    },
    {
      "name": "html_ignore_template",
      "markup": "<body><template><div>Hidden</div></template><p>Visible</p></body>",
      "expected_text": "Visible"
    },
    {
      "name": "html_ignore_hidden_attr",
      "markup": "<body><div hidden>Secret</div><p>Visible</p></body>",
      "expected_text": "Visible"
    }
  ]
}
