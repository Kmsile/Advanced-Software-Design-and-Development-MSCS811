{
  "hybrid": [
    {
      "name": "hybrid_success_standard",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello",
      "ocr_text": "World",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello\n[OCR]\nWorld",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_ocr_io_return_html",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Pre",
      "ocr_text": "Post",
      "expected_status": "return",
      "expected_text": "[HTML]\nPre",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_ocr_runtime_any_policy",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "runtime",
      "html_text": "Data",
      "ocr_text": "More",
      "expected_status": "ocr_runtime",
      "expected_text": "",
      "expected_ocr_calls": 1
    }
  ],
  "html": [
    {
      "name": "html_ignore_scripts_styles",
      "markup": "<body><script>alert(1)</script><p>Visible</p><style>.x{}</style></body>",
      "expected_text": "Visible"
    },
    {
      "name": "html_ignore_templates",
      "markup": "<body><template><p>Hidden</p></template><span>Shown</span></body>",
      "expected_text": "Shown"
    },
    {
      "name": "html_ignore_hidden_attr",
      "markup": "<body><div hidden>Ignored</div><p>Kept</p></body>",
      "expected_text": "Kept"
    }
  ]
