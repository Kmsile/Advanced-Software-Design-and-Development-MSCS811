{
  "hybrid": [
    {
      "name": "hybrid_success_both_policies",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello World",
      "ocr_text": "Scanned Text",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello World\n[OCR]\nScanned Text",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_ocr_io_return_html",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Only HTML",
      "ocr_text": "",
      "expected_status": "return",
      "expected_text": "[HTML]\nOnly HTML",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_html_io_skips_ocr",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "",
      "ocr_text": "Should Not Happen",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": 0
    }
  ],
  "html": [
    {
      "name": "html_ignore_script_style",
      "markup": "<body><p>Visible</p><script>var x=1;</script><style>.cls{}</style></body>",
      "expected_text": "Visible"
    },
    {
      "name": "html_ignore_template",
      "markup": "<body><p>Before</p><template><p>Hidden</p></template><p>After</p></body>",
      "expected_text": "Before\nAfter"
    },
    {
      "name": "html_ignore_hidden_attr",
      "markup": "<body><p>Visible</p><p hidden>Hidden Content</p></body>",
      "expected_text": "Visible"
    }
  ]
}
