{
  "hybrid": [
    {
      "name": "hybrid_success_default",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello",
      "ocr_text": "World",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello\n[OCR]\nWorld",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_ocr_io_return_html",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Visible",
      "ocr_text": "",
      "expected_status": "return",
      "expected_text": "[HTML]\nVisible",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_html_io_skip_ocr",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "",
      "ocr_text": "Should Not Appear",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": -1
    }
  ],
  "html": [
    {
      "name": "html_ignore_script",
      "markup": "<body><script>var x=1;</script><p>Text</p></body>",
      "expected_text": "Text"
    },
    {
      "name": "html_ignore_template",
      "markup": "<body><template><p>Hidden</p></template><span>Visible</span></body>",
      "expected_text": "Visible"
    },
    {
      "name": "html_ignore_hidden_attr",
      "markup": "<body><div hidden>Hidden</div><span>Visible</span></body>",
      "expected_text": "Visible"
    }
  ]
}
