{
  "hybrid": [
    {
      "name": "H1-success-default",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello",
      "ocr_text": "World",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello\n[OCR]\nWorld",
      "expected_ocr_calls": 1
    },
    {
      "name": "H2-failure-ocr-io-return_html",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Data",
      "ocr_text": "",
      "expected_status": "return",
      "expected_text": "[HTML]\nData",
      "expected_ocr_calls": 1
    },
    {
      "name": "H3-failure-html-io",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "",
      "ocr_text": "Text",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": -1
    }
  ],
  "html": [
    {
      "name": "T1-ignore-script-style-noscript",
      "markup": "<body><p>Visible</p><script>var x=1;</script><style>.cls{}</style><noscript>JS</noscript></body>",
      "expected_text": "Visible"
    },
    {
      "name": "T2-ignore-template",
      "markup": "<body><p>Before</p><template><p>Hidden</p></template><p>After</p></body>",
      "expected_text": "BeforeAfter"
    },
    {
      "name": "T3-ignore-hidden-attr",
      "markup": "<body><p>Show</p><p hidden>Hide</p><div hidden><span>DeepHide</span></div></body>",
      "expected_text": "Show"
    }
  ]
}
