      "expected_status": "return",
      "expected_text": "[HTML]\nContent",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_html_io_skips_ocr",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "",
      "ocr_text": "Should Not Appear",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": 0
    }
  ],
  "html": [
    {
      "name": "html_ignore_script_style",
      "markup": "<html><body><script>var x=1;</script><style>.a{}</style><p>Visible</p></body></html>",
      "expected_text": "Visible"
    },
    {
      "name": "html_ignore_template",
      "markup": "<html><body><template><p>Hidden</p></template><p>Visible</p></body></html>",
      "expected_text": "Visible"
    },
    {
      "name": "html_ignore_hidden_attr",
      "markup": "<html><body><div hidden>Hidden</div><p>Visible</p></body></html>",
      "expected_text": "Visible"
    }
  ]
