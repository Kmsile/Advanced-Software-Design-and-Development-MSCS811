{
  "hybrid": [
    {
      "name": "H1-success-default",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello",
      "ocr_text": "World",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello\n[OCR]\nWorld",
      "expected_ocr_calls": 1
    },
    {
      "name": "H2-failure-ocr-io-return-html",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Data",
      "ocr_text": "Ignored",
      "expected_status": "return",
      "expected_text": "[HTML]\nData",
      "expected_ocr_calls": 1
    },
    {
      "name": "H3-failure-html-io-skips-ocr",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "Ignored",
      "ocr_text": "Ignored",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": 0
    }
  ],
  "html": [
    {
      "name": "T1-ignores-script-style-noscript",
      "markup": "<body><p>Visible</p><script>hide()</script><style>.x{}</style><noscript>off</noscript></body>",
      "expected_text": "Visible"
    },
    {
      "name": "T2-ignores-template",
      "markup": "<body><p>Before</p><template><p>Hidden</p></template><p>After</p></body>",
      "expected_text": "Before After"
    },
    {
      "name": "T3-ignores-hidden-attribute",
      "markup": "<body><p>Show</p><p hidden>Hide</p></body>",
      "expected_text": "Show"
    }
  ]
}
