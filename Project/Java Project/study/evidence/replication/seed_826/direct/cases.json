{
  "hybrid": [
    {
      "name": "hybrid_success_standard_policy",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello World",
      "ocr_text": "Scanned Text",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello World\n[OCR]\nScanned Text",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_ocr_io_return_html_policy",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Visible Content",
      "ocr_text": "Ignored",
      "expected_status": "return",
      "expected_text": "[HTML]\nVisible Content",
      "expected_ocr_calls": 1
    },
    {
      "name": "hybrid_html_io_default_policy",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "Ignored",
      "ocr_text": "Ignored",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": -1
    }
  ],
  "html": [
    {
      "name": "html_strip_script_style",
      "markup": "<body><p>Before</p><script>var x=1;</script><style>.c{}</style><p>After</p></body>",
      "expected_text": "Before After"
    },
    {
      "name": "html_ignore_template",
      "markup": "<body><p>Visible</p><template><p>Hidden</p></template></body>",
      "expected_text": "Visible"
    },
    {
      "name": "html_ignore_hidden_attr",
      "markup": "<body><p>Show</p><p hidden>Hide</p><div hidden>Also Hide</div></body>",
      "expected_text": "Show"
    }
  ]
}
