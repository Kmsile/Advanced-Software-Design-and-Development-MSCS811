{
  "hybrid": [
    {
      "name": "H1-success-default-policy",
      "policy": "default",
      "html_status": "ok",
      "ocr_status": "ok",
      "html_text": "Hello",
      "ocr_text": "World",
      "expected_status": "return",
      "expected_text": "[HTML]\nHello\n[OCR]\nWorld",
      "expected_ocr_calls": 1
    },
    {
      "name": "H2-ocr-io-return-html-policy",
      "policy": "return_html",
      "html_status": "ok",
      "ocr_status": "io",
      "html_text": "Content",
      "ocr_text": "Ignored",
      "expected_status": "return",
      "expected_text": "[HTML]\nContent",
      "expected_ocr_calls": 1
    },
    {
      "name": "H3-html-io-skips-ocr",
      "policy": "default",
      "html_status": "io",
      "ocr_status": "ok",
      "html_text": "",
      "ocr_text": "Ignored",
      "expected_status": "html_io",
      "expected_text": "",
      "expected_ocr_calls": 0
    }
  ],
  "html": [
    {
      "name": "T1-ignores-script-style-noscript",
      "markup": "<body><p>Visible</p><script>var x=1;</script><style>.cls{}</style><noscript>JS off</noscript></body>",
      "expected_text": "Visible"
    },
    {
      "name": "T2-ignores-template-elements",
      "markup": "<body><p>Before</p><template><div>Hidden</div></template><p>After</p></body>",
      "expected_text": "Before After"
    },
    {
      "name": "T3-ignores-hidden-attribute",
      "markup": "<body><p>Show</p><div hidden>Hide</div><span hidden>Also Hide</span></body>",
      "expected_text": "Show"
    }
  ]
}
