        "${workspaceFolder}/build",
        "${workspaceFolder}/lib/jsoup-1.17.2.jar"
      ],
      "sourcePaths": ["${workspaceFolder}/src", "${workspaceFolder}/tests"],
      "cwd": "${workspaceFolder}",
      "args": [
        "node"
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "Build Java"
